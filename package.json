{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "playoffodds",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "vp -C . build",
    "build:ssr": "vp -C . build && vp -C . build --ssr",
    "dev": "vp -C . dev",
    "check": "vp -C . check",
    "check:fix": "vp -C . check --fix",
    "types:check": "tsc --noEmit -p tsconfig.packages.json && vue-tsc --noEmit",
    "test": "vitest run",
    "typecheck": "npm run types:check",
    "build:cli": "node packages/cli/build.mjs",
    "spike": "tsx scripts/spike-live.ts"
  },
  "dependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^6.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.2.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vite-plus": "1.4.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1",
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
